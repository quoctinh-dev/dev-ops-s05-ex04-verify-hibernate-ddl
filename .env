# Dùng chung (PostgreSQL dùng port 5432 và trỏ đến tên container quickbite-db)
DB_HOST=quickbite-db
DB_PORT=5432

# User Service
USER_DB_NAME=quickbite_user_db
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=secret
USER_SERVER_PORT=8081

# Restaurant Service
RESTAURANT_DB_NAME=quickbite_restaurant_db
RESTAURANT_DB_USERNAME=postgres
RESTAURANT_DB_PASSWORD=secret
RESTAURANT_SERVER_PORT=8082

# Order Service
ORDER_DB_NAME=quickbite_order_db
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=secret
ORDER_SERVER_PORT=8083

# Notification Service
NOTIFICATION_DB_NAME=quickbite_notification_db
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=secret
NOTIFICATION_SERVER_PORT=8084